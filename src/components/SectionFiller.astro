---
const { id, title } = Astro.props;
---
<section id={id}>
    <div>

    </div>
</section>

<style>
    section {
        container: filler \ inline-size;
    }

    section > div {
        display: flex;
        flex-direction: column;
        height: stretch;
        min-height: calc(var(--gap) * 2);
        gap: var(--gap);
    }

    section > div {
        box-shadow: inset -7rem 4rem 20rem rgba(126, 157, 216, 20%);
        background-color: light-dark(var(--blue-light), var(--blue-light));

    }

    @container filler (width < 80ch) {
        section > div {
            display: flex;
            flex-direction: column;
        }
    }
</style>