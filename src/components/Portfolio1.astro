---
import { Image, getImage } from "astro:assets";
import portBg from "../assets/portfolio_1/placeholder.png";

import Img1 from "../assets/portfolio_1/can_pic.png";
import Img2 from "../assets/portfolio_1/regional_map.png";
import Img3 from "../assets/portfolio_1/tag_lines.png";
import Img4 from "../assets/portfolio_1/world_map.png";
import Img5 from "../assets/portfolio_1/tomra_sorting.png";

const optimizedBg = await getImage({ src: portBg, format: 'webp' });
---
<div class="container" id="portfolio1">
    <section>
        <div class="content">
            <h3 class="small">General design and Infographics</h3>
            <p>Collection of infographics and general design marketing materials. These were generated using multiple design software tools, including Adobe inDesign, Adobe Photoshop, Canva and Microsoft Powerpoint. These are a mix of manually designed and AI assisted generation.</p>
            <button 
            class="more-btn"  
            aria-label="Open portfolio collection one"
            popovertargetaction="show"
            popovertarget="portfolio1Popover"
            >View project</button>
        </div>
        <button 
        class="portfolio-image image-1" 
        style={{ backgroundImage: `url(${optimizedBg.src})` }} 
        aria-label="Open portfolio collection one"
        popovertargetaction="show"
        popovertarget="portfolio1Popover"
        ></button>
    </section>
</div>

<dialog id="portfolio1Popover" popover="auto" class="portfolio">
    <div class="container">
        <div class="popover-top">
            <button 
                popovertarget="portfolio1Popover" 
                popovertargetaction="hide"
                aria-label="Close popup"
                >
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>close-md</title><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6"/></svg>
                </span>
            </button>
        </div>
        <div class="popover-content">
            <ul>
                <li>
                    <Image src={Img1} alt="decorative" width={800} height={440}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img2} alt="decorative" width={1000} height={770}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img3} alt="decorative" width={1000} height={770}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img4} alt="decorative" width={1000} height={550}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img5} alt="decorative" width={600} height={840}/>
                    <!-- <p>This is my image</p> -->
                </li>
            </ul>
        </div>
        <!-- <div class="popover-bottom">
            <button >Next</button>
            <div>dots</div>
            <button >Previous</button>
        </div> -->
    </div>
</dialog>

<style>
    :root {
        --portfolio-one: light-dark(var(--gray-light), var(--gray-light));
    }
    .container {
        container: portfolio1 / inline-size;
    }
    section {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: 1fr 1fr;
        gap: var(--gap);
    }
    .content {
        grid-column: 1 / 3;
        grid-row: 1 / -1;
        background-color: var(--portfolio-one);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--gap);
        color: light-dark(var(--gray-dark), var(--gray-dark));
    }
    h3 {
        font-size: 1.75rem;
        font-family: var(--font-sans-serif);
        padding: var(--gap-large);
        padding-block-end: 0;
        font-weight: 400;
    }
    p {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
    .more-btn {
        border: 0;
        border-block-start: var(--gap) solid var(--bg-color);
        border-inline-start: var(--gap) solid var(--bg-color);
        margin-inline-start: auto;
        padding: var(--gap);
        font-size: 1rem;
        background: light-dark(var(--blue-light), var(--blue-light));
        color: light-dark(var(--blue-dark), var(--blue-dark));
        width: calc(50% + var(--gap-small));
    }
    .portfolio-image {
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        background-position: center center;
        display: block;
        border: 0;
        box-shadow: inset 0 5rem 15rem light-dark(var(--gray-dark), var(--gray-dark));
        filter: grayscale();
        grid-column: 3 / 5;
        grid-row: 1 / -1;
    }
    @container portfolio1 (width < 80ch) {
        section {
            display: flex;
            flex-direction: column;
            gap: var(--gap);
        }
        .content {
            order: 2;
        }
        .portfolio-image {
            order: 1;
            aspect-ratio: 2 / 1;
        }
	}
</style>

<style is:global>
    dialog.portfolio {
        background: var(--bg-color);
        border: var(--gap) solid var(--bg-color);
        border-radius: 0;
        margin: auto;
        height: calc(100dvh - var(--gap-large));
        padding: var(--gap-large)0;
        overflow-y: auto;
        width: minmax(100dvw, calc(var(--page-width) - var(--gap)));
        max-width: calc(var(--page-width) - var(--gap-small));
        margin-inline: auto;
    }

    dialog.portfolio .popover-top {
        display: flex;
        justify-content: flex-end;
    }
    dialog.portfolio .popover-top button {
        background: light-dark(var(--green-dark), var(--green-dark));
        color: light-dark(var(--green-light), var(--green-light));
        padding: var(--gap);
        margin-inline-start: auto;
        min-width: 4rem;
        border: 0
    }

    dialog.portfolio .container {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: calc(100% - calc(var(--gap) * 5));
        background: light-dark(var(--white), var(--white));
        border-block-end: var(--gap) solid var(--bg-color);
        gap: var(--gap);
        padding: 0;
        margin: auto 0;
    }

    dialog.portfolio .popover-content {
        height: 100%;
        overflow-y: auto;
    }
    dialog.portfolio ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--gap);
    }
    dialog.portfolio ul li {
        background: light-dark(var(--gray-light), var(--gray-light));
        display: flex;
        flex-direction: column;
        padding: var(--gap-large);
        align-items: center;
    }
    dialog.portfolio a {
        padding: var(--gap);
        display: block;
    }

    dialog.portfolio .popover-bottom {
        display: flex;
        justify-content: space-between;
    }

    dialog.portfolio .popover-bottom button {
        background: light-dark(var(--green-light), var(--green-light));
        color: light-dark(var(--green-dark), var(--green-dark));
        padding: var(--gap);
        min-width: 4rem;
        border: 0;
    }
</style>