---
import { getImage } from "astro:assets";
import portBg from "../assets/portfolio_1/placeholder.png";

const optimizedBg = await getImage({ src: portBg, format: 'webp' });
---
<div class="container" id="portfolio-1">
    <section>
        <div class="content">
            <h3 class="small">General design and Infographics</h3>
            <p>Collection of infographics and general design marketing materials. These were generated using multiple design software tools, including Adobe inDesign, Adobe Photoshop, Canva and Microsoft Powerpoint. These are a mix of manually designed and AI assisted generation.</p>
            <button 
            class="more-btn"  
            aria-label="Open portfolio collection one"
            popovertargetaction="show"
            popovertarget="myPopover"
            >View project</button>
        </div>
        <button 
        class="portfolio-image image-1" 
        style={{ backgroundImage: `url(${optimizedBg.src})` }} 
        aria-label="Open portfolio collection one"
        popovertargetaction="show"
        popovertarget="myPopover"
        ></button>
    </section>
</div>

<dialog id="myPopover" popover="auto">
    <div class="popover-top">
        <button popovertarget="myPopover" popovertargetaction="hide">Close</button>
    </div>
    <div class="popover-content">
        <ul>
            <li><p>This is my image</p></li>
            <li><p>This is my image</p></li>
            <li><p>This is my image</p></li>
        </ul>
    </div>
    <div class="popover-bottom">
        <button >Next</button>
        <div>dots</div>
        <button >Previous</button>
    </div>
</dialog>

<style>
    :root {
        --portfolio-one: light-dark(var(--gray-light), var(--gray-dark));
    }
    .container {
        container: portfolio1 / inline-size;
    }
    section {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        grid-template-rows: 1fr 1fr;
        gap: var(--gap);
    }
    .content {
        grid-column: 1 / 3;
        grid-row: 1 / -1;
        background-color: var(--portfolio-one);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--gap);
        color: light-dark(var(--gray-dark), var(--white));
    }
    h3 {
        font-size: 1.75rem;
        font-family: var(--font-sans-serif);
        padding: var(--gap-large);
        padding-block-end: 0;
        font-weight: 400;
    }
    p {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
    .more-btn {
        border: 0;
        border-block-start: var(--gap) solid var(--bg-color);
        border-inline-start: var(--gap) solid var(--bg-color);
        margin-inline-start: auto;
        padding: var(--gap);
        font-size: 1rem;
        background: light-dark(var(--blue-light), var(--gray-light));
        width: calc(50% + var(--gap-small));
    }
    .portfolio-image {
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        background-position: center center;
        display: block;
        border: 0;
        box-shadow: inset 0 5rem 15rem light-dark(var(--gray-dark), var(--gray-dark));
        filter: grayscale();
        grid-column: 3 / 5;
        grid-row: 1 / -1;
    }
    @container portfolio1 (width < 80ch) {
        section {
            display: flex;
            flex-direction: column;
            gap: var(--gap);
        }
        .content {
            order: 2;
        }
        .portfolio-image {
            order: 1;
            aspect-ratio: 2 / 1;
        }
	}
</style>

<style is:global>
    [popover] {
        width: minmax(100dvw, calc(var(--page-width) - var(--gap)));
        max-width: calc(var(--page-width) - var(--gap-small));
        margin-inline: auto;
        min-height: 100dvh;
        border: none;
    }
    [popover]::backdrop {
        background: rgba(0, 0, 0, 0.4);
    }
</style>