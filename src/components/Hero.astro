---
import { Image } from 'astro:assets';
import VlmImage from '../assets/vlmangrich_headshot_1.png';
import { HERO_TITLE, HERO_TEXT, HERO_IMAGE_ALT } from '../consts';

---
<div class="container">
    <div class="hero">
        <Image 
        src={VlmImage} 
        alt={ HERO_IMAGE_ALT } 
        class={'circle'}
        width={300}
        height={300}
        />
        <hgroup>
            <h1>{ HERO_TITLE }</h1>
            <p>{ HERO_TEXT }</p>
        </hgroup>
    </div>
</div>
<style>
    .container {
		container: hero / inline-size;
    }
    .hero {
        display: flex;
        padding: var(--gap-large);
        gap: var(--gap-large);
        align-items: center;
        min-height: clamp(15rem, 30vw, 24rem);
        background: light-dark(rgb(191, 221, 238), rgb(51, 52, 80));
        box-shadow: inset -7rem 4rem 20rem rgba(126, 157, 216, 10%);
    }
    hgroup {
        display: flex;
        flex-direction: column;
        gap: var(--gap);
        line-height: 1.3;
        text-wrap: balance;
        color: rgb(37, 80, 105);
        max-width: 60ch;
    }
    h1 {
        color: light-dark(rgb(51, 52, 80), rgb(225, 225, 225));
        font-size: clamp(2rem, 4vw, 4rem);
    }
    p {
        margin: 0;
        font-size: clamp(1.25rem, 2.5vw, 2rem);
        line-height: 1.5;
        color: light-dark(rgb(51, 52, 80), rgba(225, 225, 225, 85%));
    }
    img {
        border-radius: 100%;
        border: var(--gap) solid white;
        max-width: clamp(9rem, 18vw, 240px);
	    filter: grayscale()
    }

    @container hero (width < 50ch) {
        .hero {
            flex-direction: column;
            text-align: center;
            padding: var(--gap);
            gap: var(--gap);
        }
    }
</style>