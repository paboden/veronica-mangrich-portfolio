---
import { getImage } from "astro:assets";
import myBackground1 from "../assets/blog-placeholder-1.jpg";

const optimizedBackground1 = await getImage({ src: myBackground1, format: 'webp' });
---
<div class="container" id="portfolio-2">
    <section>
        <div class="content">
            <h3 class="small">In this e-Can-omy? Buy More Cans!</h3>
            <p>A new and simple concept was needed, to help remind people that buying canned food is a great way to stretch your food dollars. A 1950's, nostalgic style artwork achieves this. Currently, It is mainly used on swag items, such as large canvas bags and t-shirts.</p>
            <button 
            class="more-btn"  
            aria-label="Open portfolio collection"
            popovertargetaction="show"
            popovertarget="myPopover"
            >View project</button>
        </div>
       <button 
        class="portfolio-image image-1" 
        style={{ backgroundImage: `url(${optimizedBackground1.src})` }} 
        aria-label="Open portfolio collection one"
        popovertargetaction="show"
        popovertarget="myPopover"
        ></button>
    </section>
</div>

<dialog id="myPopover" popover="auto">
    <div class="popover-top">
        <button popovertarget="myPopover" popovertargetaction="hide">Close</button>
    </div>
    <div class="popover-content">
        <ul>
            <li><p>This is my image</p></li>
            <li><p>This is my image</p></li>
            <li><p>This is my image</p></li>
        </ul>
    </div>
    <div class="popover-bottom">
        <button >Next</button>
        <div>dots</div>
        <button >Previous</button>
    </div>
</dialog>

<style>
    :root {
        --portfolio-two: light-dark(var(--gray-light), var(--gray-dark));
    }
    .container {
        container: portfolio2 / inline-size;
    }
    section {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: 1fr;
        gap: var(--gap);
    }
    .content {
        grid-column: 2 / -1;
        grid-row: 1 / -1;
        background-color: var(--portfolio-two);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--gap);
        color: light-dark(var(--blue-dark), var(--white));
    }
    h3 {
        font-size: 1.75rem;
        font-family: var(--font-sans-serif);
        padding: var(--gap-large);
        padding-block-end: 0;
        font-weight: 400;
    }
    p {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
    .more-btn {
        border: 0;
        border-block-start: var(--gap) solid var(--bg-color);
        border-inline-start: var(--gap) solid var(--bg-color);
        margin-inline-start: auto;
        padding: var(--gap);
        font-size: 1rem;
        background: light-dark(var(--blue-light), var(--gray-light));
        width: calc(50% + var(--gap-small));
    }
    .portfolio-image {
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        background-position: center center;
        display: block;
        border: 0;
        box-shadow: inset 0 5rem 15rem light-dark(var(--gray-dark), var(--gray-dark));
        filter: grayscale();
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        display: block;
    }
	@container portfolio2 (width < 80ch) {
        section {
            display: flex;
            flex-direction: column;
            gap: var(--gap);
        }
        .content {
            order: 2;
        }
        .portfolio-image {
            order: 1;
            aspect-ratio: 2 / 1;
       }
	}
</style>