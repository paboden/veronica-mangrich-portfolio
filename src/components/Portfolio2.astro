---
import { Image, getImage } from "astro:assets";
import portBg from "../assets/portfolio_2/placeholder.png";

const optimizedBg = await getImage({ src: portBg, format: 'webp' });

import Img1 from "../assets/portfolio_2/buy_more_cans_1.png";
import Img2 from "../assets/portfolio_2/buy_more_cans_2.png";
---
<div class="container" id="portfolio2">
    <section>
        <div class="content">
            <h3 class="small">In this e-Can-omy? Buy More Cans!</h3>
            <p>A new and simple concept was needed, to help remind people that buying canned food is a great way to stretch your food dollars. A 1950's, nostalgic style artwork achieves this. This design is used on swag canvas bags</p>
            <button 
            class="more-btn"  
            aria-label="Open portfolio collection"
            popovertargetaction="show"
            popovertarget="portfolio2Popover"
            >View project</button>
        </div>
       <button 
        class="portfolio-image image-1" 
        style={{ backgroundImage: `url(${optimizedBg.src})` }} 
        aria-label="Open portfolio collection one"
        popovertargetaction="show"
        popovertarget="portfolio2Popover"
        ></button>
    </section>
</div>

<dialog id="portfolio2Popover" popover="auto" class="portfolio">
    <div class="container">
        <div class="popover-top">
            <button 
                popovertarget="portfolio2Popover" 
                popovertargetaction="hide"
                aria-label="Close popup"
                >
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>close-md</title><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6"/></svg>
                </span>
            </button>
        </div>
        <div class="popover-content">
            <ul>
               <li>
                    <Image src={Img1} alt="decorative" width={1000} height={1000}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img2} alt="decorative" width={1000} height={1000}/>
                    <!-- <p>This is my image</p> -->
                </li>
            </ul>
        </div>
        <!-- <div class="popover-bottom">
            <button >Next</button>
            <div>dots</div>
            <button >Previous</button>
        </div> -->
    </div>
</dialog>

<style>
    :root {
        --portfolio-two: light-dark(var(--gray-light), var(--gray-light));
    }
    .container {
        container: portfolio2 / inline-size;
    }
    section {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: 1fr;
        gap: var(--gap);
    }
    .content {
        grid-column: 2 / -1;
        grid-row: 1 / -1;
        background-color: var(--portfolio-two);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--gap);
        color: light-dark(var(--blue-dark), var(--blue-dark));
    }
    h3 {
        font-size: 1.75rem;
        font-family: var(--font-sans-serif);
        padding: var(--gap-large);
        padding-block-end: 0;
        font-weight: 400;
    }
    p {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
    .more-btn {
        border: 0;
        border-block-start: var(--gap) solid var(--bg-color);
        border-inline-start: var(--gap) solid var(--bg-color);
        margin-inline-start: auto;
        padding: var(--gap);
        font-size: 1rem;
        background: light-dark(var(--blue-light), var(--blue-light));
        color: light-dark(var(--blue-dark), var(--blue-dark));
        width: calc(50% + var(--gap-small));
    }
    .portfolio-image {
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        background-position: center center;
        display: block;
        border: 0;
        box-shadow: inset 0 5rem 15rem light-dark(var(--gray-dark), var(--gray-dark));
        filter: grayscale();
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        display: block;
    }
	@container portfolio2 (width < 80ch) {
        section {
            display: flex;
            flex-direction: column;
            gap: var(--gap);
        }
        .content {
            order: 2;
        }
        .portfolio-image {
            order: 1;
            aspect-ratio: 2 / 1;
       }
	}
</style>