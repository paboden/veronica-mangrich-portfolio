---
import { Image, getImage } from "astro:assets";
import portBg from "../assets/portfolio_3/placeholder.png";

const optimizedBg = await getImage({ src: portBg, format: 'webp' });

import Img1 from "../assets/portfolio_3/cherries.png";
import Img2 from "../assets/portfolio_3/gfs_fruit_bowl_foodservice.png";
import Img3 from "../assets/portfolio_3/ketchup.png";
---
<div class="container" id="portfolio3">
    <section>
        <div class="content">
            <h3 class="small">Point of Sales</h3>
            <p>Point of sales marketing pieces are custom made for general customers or for specific brands. They provide details for a wide arrangement of our products.</p>
            <button 
            class="more-btn"  
            aria-label="Open portfolio collection"
            popovertargetaction="show"
            popovertarget="portfolio3Popover"
            >View project</button>
        </div>
        <button 
        class="portfolio-image image-1" 
        style={{ backgroundImage: `url(${optimizedBg.src})` }} 
        aria-label="Open portfolio collection"
        popovertargetaction="show"
        popovertarget="portfolio3Popover"
        ></button>
    </section>
</div>

<dialog id="portfolio3Popover" popover="auto" class="portfolio">
    <div class="container">
        <div class="popover-top">
            <button 
                popovertarget="portfolio3Popover" 
                popovertargetaction="hide"
                aria-label="Close popup"
                >
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>close-md</title><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6"/></svg>
                </span>
            </button>
        </div>
        <div class="popover-content">
            <ul>
               <li>
                    <Image src={Img1} alt="decorative" width={1000} height={780}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img2} alt="decorative" width={750} height={570}/>
                    <!-- <p>This is my image</p> -->
                </li>
                <li>
                    <Image src={Img3} alt="decorative" width={650} height={900}/>
                    <!-- <p>This is my image</p> -->
                </li>
            </ul>
        </div>
        <!-- <div class="popover-bottom">
            <button >Next</button>
            <div>dots</div>
            <button >Previous</button>
        </div> -->
    </div>
</dialog>

<style>
    :root {
        --portfolio-three: light-dark(var(--gray-light), var(--gray-light));
    }
    .container {
        container: portfolio3 / inline-size;
    }
    section {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        grid-template-rows: 1fr 1fr;
        gap: var(--gap);
    }
    .content {
        grid-column: 1 / 2;
        grid-row: 1 / -1;
        background-color: var(--portfolio-three);
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        gap: var(--gap);
        color: light-dark(var(--gray-dark), var(--gray-dark));
    }
    h3 {
        font-size: 1.75rem;
        font-family: var(--font-sans-serif);
        padding: var(--gap-large);
        padding-block-end: 0;
        font-weight: 400;
    }
    p {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
    .more-btn {
        border: 0;
        border-block-start: var(--gap) solid var(--bg-color);
        border-inline-start: var(--gap) solid var(--bg-color);
        margin-inline-start: auto;
        padding: var(--gap);
        font-size: 1rem;
        background: light-dark(var(--blue-light), var(--blue-light));
         color: light-dark(var(--blue-dark), var(--blue-dark));
       width: calc(50% + var(--gap-small));
    }
    .portfolio-image {
        background-color: var(--gray-light);
        background-repeat: none;
        background-size: cover;
        background-position: center center;
        display: block;
        border: 0;
        box-shadow: inset 0 5rem 15rem light-dark(var(--gray-dark), var(--gray-dark));
        filter: grayscale();
        grid-column: 2 / 3;
        grid-row: 1 / -1;
    }
    @container portfolio3 (width < 80ch) {
        section {
            display: flex;
            flex-direction: column;
            gap: var(--gap);
        }
        .content {
            order: 2;
        }
        .portfolio-image {
            order: 1;
            aspect-ratio: 2 / 1;
       }
	}
</style>

