---
import { SITE_TITLE } from '../consts';
---
<section class="section__logo">
	<div class="logo"><a href="https://paboden.github.io/veronica-mangrich-portfolio/">{SITE_TITLE}</a></div>
</section>

<style>
    .section__logo {
		container: header / inline-size;
	}
	.section__logo {
		align-content: center;
		justify-content: space-around;
		padding: 1rem 1rem;
        background: rgb(47, 82, 48);
        box-shadow: inset 0 3rem 5rem rgb(31, 55, 32, 50%);
	}
	.logo {
		margin: 0;
	    font-family: var(--font-serif);
		font-size: 1.2rem;
        letter-spacing: .3px;
		font-weight: 300;
		text-shadow: 0 0 .5rem rgba(#293B3B, 70%);
        text-align: center;
	}
	.logo a,
	.logo a.active {
		text-decoration: none;
        color: white
	}
    @container header (width > 30ch) {
		.logo {
		    text-align: left;
		}
	}
</style>