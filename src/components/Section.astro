---
const { id, title } = Astro.props;
---
<section id={id}>
    <div>
        { title && <h2>{ title }</h2>}
        <slot />
    </div>
</section>

<style>
    section {
        container: section \ inline-size;
    }
    section > div {
        display: flex;
        flex-direction: column;
        height: stretch;
        gap: 1.5rem;
    }
    section > div {
        padding: var(--gap-large) ;
        background: light-dark(var(--gray-light), var(--gray-light));
    }
    #about > div {
        padding-block-start: calc(var(--gap-large) * 3);
    }
    #portfolio > div {
        padding-block-start: calc(var(--gap-large) * 3);
        background: rgb(197, 223, 192);
    }
    #experience > div {
        padding-block-start: calc(var(--gap-large) * 3);
        background: light-dark(var(--blue-dark), var(--blue-dark));
        color: light-dark(var(--white), var(--white));
    }
    @container section (width < 80ch) {
        section > div {
            display: flex;
            flex-direction: column;
        }
    }
</style>

