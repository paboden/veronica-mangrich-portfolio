---
import Logo from '../components/Logo.astro';
import Navigation from '../components/Navigation.astro';

---
<header>
	<div id="home">
		<Logo />
		<Navigation />
	</div>
</header>

<style>
	header {
		container: header / inline-size;
	}
	header > div {
		padding: 1rem;
		display: grid;
		grid-template-columns: 1fr 3fr;
		gap: 1rem;
		margin-inline: auto;
		max-width: var(--page-width);
	}
	@container header (width < 80ch) {
		header > div {
			padding: 1rem;
			display: grid;
			grid-template-columns: auto 4rem;
			gap: 1rem;
		}
	}

	.filler {
		background: rgb(138, 177, 139);
	}
</style>