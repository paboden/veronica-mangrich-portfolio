<section id="skills">
    <div>
        <h2>Skills</h2>
        <div class="content">
            <ul>
                <li>Microsoft Word, Excel, Power Point</li>
                <li>inDesign, Photoshop, Canva</li>
                <li>JDE</li>
                <li>Qlikview</li>
                <li>Self-motivated</li>
                <li>Resourceful</li>
                <li>Willingness to learn</li>
                <li>High attention to detail</li>
                <li>Dependable</li>
            </ul>
        </div>
    </div>
</section>

<style>
    section {
        container: skills \ inline-size;
    }

    section > div {
        display: flex;
        flex-direction: column;
        height: stretch;
        gap: 0;
        background-color: light-dark(var(--blue-light), var(--blue-light));
        color: light-dark(var(--blue-dark), var(--blue-dark));
        box-shadow: inset -7rem 4rem 20rem rgba(126, 157, 216, 20%);
    }

    h2 {
        padding: var(--gap-large);
    }

    .content {
        padding: var(--gap-large);
        padding-block-start: 0;
    }
</style>