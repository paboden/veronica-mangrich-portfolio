---
import HeaderLink from "./HeaderLink.astro";

---
<section id="navigation" class="section__navigation">
    <button 
        class="mobile-button" 
        popovertarget="navigationPopup" 
        aria-label="Open Navigation"
        >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17h18M3 12h18M3 7h18"/></svg>
    </button>
    <nav class="internal-links">
        <HeaderLink href="#home">Home</HeaderLink>
        <HeaderLink href="#about">About</HeaderLink>
        <HeaderLink href="#portfolio">Portfolio</HeaderLink>
        <HeaderLink href="#experience">Experience</HeaderLink>
        <HeaderLink href="#skills">Skills</HeaderLink>
        <HeaderLink href="#education">Education</HeaderLink>
        <HeaderLink href="#contact">Contact</HeaderLink>
    </nav>
    <dialog id="navigationPopup" popover>
        <nav>
            <button 
                popovertarget="navigationPopup" 
                popovertargetaction="hide"
                aria-label="Close navigation"
                >
                <span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><title>close-md</title><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m18 18l-6-6m0 0L6 6m6 6l6-6m-6 6l-6 6"/></svg>
                </span>
            </button>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#portfolio">Portfolio</a></li>
                <li><a href="#experience">Experience</a></li>
                <li><a href="#skills">Skills</a></li>
                <li><a href="#education">Education</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </dialog>
</section>

<script>
  const nav_popup = document.getElementById("navigationPopup");
  const nav_popup_links = document.querySelectorAll(".section__navigation dialog a");

  if (nav_popup) {
    nav_popup_links.forEach((nav_popup_links) => {
        nav_popup_links.addEventListener("click", () => {
            nav_popup.togglePopover();
        });
    });
  }
</script>

<style>
	.section__navigation {
		container: section__navigation / inline-size;
	}

	.section__navigation  {
		align-content: center;
		justify-content: space-around;
        background: rgb(197, 223, 193);
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--gap);
		margin-inline: var(--gap-large);
	}
	nav a {
		padding: 0;
		color: var(--green-dark);
		font-size: 1rem;
		text-decoration: none;
        font-weight: 600;
	}
	nav a.active {
		text-decoration: none;
        border: 4px solid light-dark(var(--green-dark), var(--green-dark));
	}
	.mobile-button {
		display: none;
	}
	@container section__navigation (width < 30ch) {
		nav {
			display: none;
		}
		.mobile-button {
			display: block;
            place-items: center;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            border: none;
            background: transparent;
            color: light-dark(var(--black), var(--black));
		}
        .mobile-button svg {
			width: 100%;
            height: auto;
            color: light-dark(var(--black), var(--black));
            margin-inline: auto;
        }
	}
</style>

<style>
    dialog {
        width: minmax(100dvw, calc(var(--page-width) - var(--gap)));
        max-width: calc(var(--page-width) - var(--gap-small));
        margin-inline: auto;
        /* min-height: 100dvh; */

        background: light-dark(var(--gray-light), var(--gray-dark));
        border: var(--gap) solid var(--bg-color);
        border-radius: 0;
        height: calc(100dvh - var(--gap-large));
        padding: 0;
        overflow-y: auto;
    }
    dialog[popover]::backdrop {
        background: var(--bg-color);
    }
    dialog nav {
        display: flex;
        flex-direction: column;
        background: light-dark(var(--white), var(--black));
        border-block-end: var(--gap) solid var(--bg-color);
        padding: 0;
        margin: 0;
    }
    dialog nav ul {
        list-style-type: none;
        margin: 0;
        padding: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: var(--gap);
    }
    dialog nav ul li {
        background: light-dark(var(--green-light), var(--green-dark));
        display: block;
    }
    dialog nav a {
        padding: var(--gap);
        display: block;
    }
    dialog nav button {
        background: light-dark(var(--green-dark), var(--green-light));
        color: light-dark(var(--green-light), var(--green-dark));
        padding: var(--gap);
        margin-inline-start: auto;
        min-width: 4rem;
    }
</style>

