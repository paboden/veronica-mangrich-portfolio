---
import HeaderLink from "./HeaderLink.astro";

---
<section class="section__navigation">
    <button 
        class="mobile-button"
        id="menu-btn"
        popovertarget="menuPopup"
        style="anchor-name: --menu-btn;"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17h18M3 12h18M3 7h18"/></svg>
    </button>
    <nav class="internal-links">
        <HeaderLink href="#home">Home</HeaderLink>
        <HeaderLink href="#about">About</HeaderLink>
        <HeaderLink href="#portfolio">Portfolio</HeaderLink>
        <HeaderLink href="#experience">Experience</HeaderLink>
        <HeaderLink href="#skills">Skills</HeaderLink>
        <HeaderLink href="#education">Education</HeaderLink>
        <HeaderLink href="#contact">Contact</HeaderLink>
        <!-- <HeaderLink href="/resume">Resume</HeaderLink> -->
    </nav>
    <dialog id="menuPopup" popover>
        <button popovertarget="menuPopup" popovertargetaction="hide">Close</button>
        <a href="#home"><span popovertarget="menuPopup" popovertargetaction="hide">Home</span></a>
        <a href="#about" popovertargetaction="hide">About</a>
        <a href="#portfolio" popovertargetaction="close">Portfolio</a>
        <a href="#experience" popovertargetaction="close">Experience</a>
        <a href="#skills" popovertargetaction="close">Skills</a>
        <a href="#education" popovertargetaction="close">Education</a>
        <a href="#contact" popovertargetaction="close">Contact</a>
    </dialog>
</section>

<style>
	.section__navigation {
		container: section__navigation / inline-size;
	}

	.section__navigation  {
		align-content: center;
		justify-content: space-around;
        background: rgb(197, 223, 193);
	}

	nav {
		display: flex;
		align-items: center;
		gap: var(--gap);
		margin-inline: var(--gap-large);
	}
	nav a {
		padding: 0;
		color: var(--green-dark);
		font-size: 1rem;
		text-decoration: none;
        font-weight: 600;
	}
	nav a.active {
		text-decoration: none;
        border: 4px solid light-dark(var(--green-dark), var(--green-light));
	}
	.mobile-button {
		display: none;
	}
	@container section__navigation (width < 30ch) {
		nav {
			display: none;
		}
		.mobile-button {
			display: block;
            place-items: center;
            display: flex;
            width: stretch;
            align-items: center;
            justify-items: center;
            border: none;
            background: transparent;
            color: light-dark(var(--black), var(--white));
		}
        .mobile-button svg {
			width: 100%;
            height: auto;
            color: light-dark(var(--black), var(--white));
            margin-inline: auto;
        }
	}
</style>