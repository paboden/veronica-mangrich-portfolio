---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Row from '../components/Row.astro';
import Section from '../components/Section.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---
<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<Row columns="2">
		<Section>
			<p>Results-driven administrative and operations professional with extensive experience in reporting, sales support, customer service, marketing coordination, and office management. Adept at managing multiple priorities, improving processes, coordinating cross-functional projects, and supporting executive leadership.</p>
		</Section>
		<Section>
			<p>Combines strong analytical skills with creative marketing experience and a commitment to accuracy, customer service, and team success. Skilled in business systems such as JDE, QlikView, Microsoft Office, Smartsheet, InDesign, Photoshop, and various supplier management platforms.</p>
		</Section>
	</Row>
	<Row columns="1">
		<Section>
			<h2>Current Role</h2>
			<hgroup>
				<h3>Senior Administrative Assistant</h3> 
				<time datetime="2021">2021</time>-<time datetime="2026">Present</time>
				<p>Pacific Coast Producers</p>
			</hgroup>
			<ul>
				<li>
					<p>Systems & Reporting</p>
					<ul>
						<li>Proficient in JDE, QlikView, Smartsheet, Outlook, Microsoft Office, Syndigo, and Sysco Supplier Suite.</li>
						<li>Generate monthly, quarterly, and annual accruals; run 30+ monthly sales reports, weekly warehouse/scorecard/YTD reports, and trend reports.</li>
						<li>Compile weekly win reports and prepare monthly Sysco reports.</li>
						<li>Reconcile corporate AMEX statements.</li>
					</ul>
				</li>
				<li>
					<p>Administrative & Operational Support</p>
					<ul>
						<li>Manage sample requests: logging, submitting, tracking, and coordinating shipments.</li>
						<li>Process invoices, submit to AR, and prepare check mailings.</li>
						<li>Coordinate travel arrangements and create itineraries.</li>
						<li>Organize major events including annual Chicago Broker Meeting and Foodservice Broker Plant Tours (50+ attendees).</li>
						<li>Maintain and update Broker Tour Calendar and FS Broker Binder.</li>
					</ul>
				</li>
				<li>
					<p>Sales & Business Support</p>
					<ul>
						<li>Prepare BID submissions: obtain approvals, apply pricing, and update BID sheets.</li>
						<li>Support Business Analyst with broker reports, trend analysis, and warehouse reporting.</li>
						<li>Maintain multiple supplier platforms and assist with NIF/Teamwork projects across Foodservice and Retail.</li>
					</ul>
				</li>
				<li>
					<p>Marketing & Creative</p>
					<ul>
						<li>Create and update POS materials, flyers, sales sheets, and popup banners using InDesign.</li>
						<li>Photograph products and enhance images using Photoshop.</li>
						<li>Support website updates (WordPress) and contribute to crop reports and mock-ups.</li>
						<li>Prepare booth materials and swag for trade shows and events; coordinate shipments</li>
						<li>Film and prepare video content for management presentations.</li>
					</ul>
				</li>
				<li>
					<p>Quality Assurance Support</p>
					<ul>
						<li>Obtain and submit QA documentation for customers; assist in maintaining food safety records.</li>
						<li>Manage Label Destruction Tracking for Foodservice and Retail.</li>
					</ul>
				</li>
				<li>
					<p>Executive & CrossFunctional Support</p>
					<ul>
						<li>Assist upper management with presentations, letters of support, swag preparation, and product pickups.</li>
						<li>Support PowerPoint presentation development (images, animations, GIFs)</li>
					</ul>
				</li>
			</ul>
		</Section>
</Row>
			<Row columns="1">

		<Section>
			<h2>Experience</h2>
			<hgroup>
				<h3>Customer Service Representative</h3> 
				<time datetime="2020">2020</time>-<time datetime="2021">2021</time>
				<p>Pacific Coast Producers</p>
			</hgroup>
			<ul>
				<li>Navigate through JDE, Qlikview, Order Change Log, Outlook, and Microsoft Office Programs</li>
				<li>Prepare monthly label inventory reports to send to customers</li>
				<li>Enclosure billing reports</li>
				<li>Process and audit orders</li>
				<li>Restock labels</li>
				<li>Manage daily stock shortages</li>
				<li>Communicate directly with broker/customer</li>
				<li>Work with the Sales Team when pricing and stock issues arise</li>
				<li>Assist the Marketing Team with creating salesheets with InDesign and updating product information on company website</li>
			</ul>

			<hgroup>
				<h3>Office Manager</h3> 
				<time datetime="2017">2017</time>-<time datetime="2019">2019</time>
				<p>Walker Veterinary Hospital</p>
			</hgroup>
			<ul>
				<li>Managed daily operations and schedules of employees</li>
				<li>Directly dealt with multiple venders</li>
				<li>Maintained detailed files of company accounts</li>
				<li>Implemented the shift to digital medical records</li>
				<li>Managed monthly accounts receivables</li>
				<li>Responsible for recruiting, hiring, performance reviews and necessary disciplinary actions.</li>
			</ul>

			<hgroup>
				<h3>Assistant Office Manager</h3> 
				<time datetime="2010">2010</time>-<time datetime="2017">2017</time>
				<p>Walker Veterinary Hospital</p>
			</hgroup>
			<ul>
				<li>Provide daily support to the Office Manager’s needs</li>
				<li>Counted daily till and created weekly deposits</li>
				<li>Maintained inventory and supplies</li>
				<li>Trained receptionists and kennel technicians</li>
				<li>Maintained office and lab equipment by running quality control</li>
				<li>Trained to open and close the office and building</li>
			</ul>
		</Section>
	</Row>

	<Row columns="2">
		<Section>
			<h2>Skills</h2>
			<ul>
				<li>Microsoft Word, Excel, Power Point</li>
				<li>JDE</li>
				<li>Qlikview</li>
				<li>Self-motivated</li>
				<li>Resourceful</li>
				<li>Willingness to learn</li>
				<li>High attention to detail</li>
				<li>Dependable</li>
			</ul>
		</Section>

		<Section>
        	<h2>Education</h2>
        	<h3>Bachelor of Arts in Nutrition<br><em>with option in General Dietetics</em></h3>
          	<p>California State University, Chico</p>
          	<p class="location">Chico, California<time datetime="2007-06-01">June 2007</time></p>
        	<h3>Associates in Veterinary Technology</h3>
          	<p>Carrington College of California</p>
          	<p class="location">Stockton, California<time datetime="2012-08-01">August 2012</time></p>
		</Section>
	</Row>

</Layout>